{
  "titulo": "AcessaIA",
  "subtitulo": "Interface gráfica adaptativa com apoio de Inteligência Artificial e IoT",
  "ods": {
    "numero": 10,
    "nome": "Redução das Desigualdades",
    "meta": "Meta 10.2 – Até 2030, empoderar e promover a inclusão social, econômica e política de todos, independentemente de idade, sexo, deficiência, raça, etnia, origem, religião ou condição econômica."
  },
  "secoes": [
    {
      "id": "sobre",
      "titulo": "Sobre o projeto",
      "texto": "O AcessaIA é um protótipo de portal web que se adapta às necessidades de quem o utiliza. Ele foi construído a partir de uma pesquisa de campo com pessoas com deficiência, que apontaram as barreiras mais frequentes em sites e aplicativos. Cada recurso do portal responde a uma dessas barreiras."
    },
    {
      "id": "recursos",
      "titulo": "Recursos de acessibilidade",
      "itens": [
        {
          "icone": "🎙️",
          "nome": "Comando de voz",
          "descricao": "Navegue falando: diga \"ler página\", \"alto contraste\", \"aumentar fonte\", \"descrever imagem\" ou \"ir para pesquisa\".",
          "barreira": "Não dá para navegar por voz ou teclado"
        },
        {
          "icone": "🔊",
          "nome": "Leitura em voz alta",
          "descricao": "O conteúdo da página é lido por síntese de voz em português, com velocidade ajustável.",
          "barreira": "Leitura de textos / baixa visão"
        },
        {
          "icone": "🖼️",
          "nome": "Descrição de imagens por IA",
          "descricao": "Uma rede neural (MobileNet) roda no próprio navegador, identifica o conteúdo da imagem e gera uma descrição falada.",
          "barreira": "Imagens sem descrição"
        },
        {
          "icone": "🌓",
          "nome": "Temas de alto contraste",
          "descricao": "Três temas visuais (padrão, alto contraste e amarelo sobre preto) que atendem às razões de contraste da WCAG 2.1.",
          "barreira": "Baixo contraste de cores"
        },
        {
          "icone": "🔠",
          "nome": "Ajuste de fonte e espaçamento",
          "descricao": "Aumente o texto em até 200% e ative a fonte e o espaçamento para leitura facilitada.",
          "barreira": "Letras pequenas"
        },
        {
          "icone": "📳",
          "nome": "Feedback tátil (IoT)",
          "descricao": "Cada ação confirmada gera um padrão de vibração no celular ou em uma pulseira com ESP32 e motor de vibração.",
          "barreira": "Confirmação de ações para pessoas surdas ou cegas"
        }
      ]
    }
  ],
